{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "skipLibCheck": true
  },
  "include": [
    "index.js",
    "index-node.js",
    "lib/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}